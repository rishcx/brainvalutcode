# Copy to .env for the Mac CLI. Placeholders only; never commit real values.
# For the Worker these are set with `npx wrangler secret put NAME` instead (see docs/OPS.md).

# GitHub token: read access for polling; on the Worker it also needs write access to the vault repo (Contents: read/write).
# Two fine-grained tokens (least privilege). Read: All repositories, Metadata+Issues+Pull requests read-only.
GITHUB_TOKEN_READ=github_pat_read_only_token_here
# Vault: ONLY the vault repo, Contents read/write. Used by the Worker to commit notes.
GITHUB_TOKEN_VAULT=github_pat_vault_write_token_here

# Mac only: key for the local gateway at localhost:20128. Never set on the Worker.
OMNIROUTE_KEY=your_local_gateway_key
# Groq: free, fast, OpenAI-compatible (console.groq.com -> API Keys). Used FIRST when set; works on both runtimes.
GROQ_KEY=gsk_your_groq_key_here
# Fallback LLM provider (works on both runtimes). Free tier = only 50 requests/day; add $10 credit for 1000/day.
OPENROUTER_KEY=sk-or-your-key-here

# Worker only: bearer token protecting POST /admin/run. Use a long random string.
ADMIN_TOKEN=long_random_string
# Worker only: vault repo and branch (these live in wrangler.toml [vars], not secrets).
VAULT_REPO=your-github-user/your-vault-repo
VAULT_BRANCH=main

# Telegram: bot token from @BotFather.
TELEGRAM_TOKEN=123456:your_bot_token
# Telegram: random string sent back by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=random_secret_string
# Telegram: random URL segment; the webhook lives at /wh/tg/<this>.
TELEGRAM_WEBHOOK_PATH=random-url-segment

# WhatsApp Cloud API.
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=random_verify_string

# Gmail (metadata-only) OAuth credentials.
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# Optional: pin a newer Graph API version if Meta retires the default (v21.0).
# WHATSAPP_GRAPH_VERSION=v23.0
